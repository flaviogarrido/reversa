<ui:FluentWindow x:Class="SkillStudio.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Configurações" Width="620" Height="760" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Configurações" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Padding="24,4,24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="REPOSITÓRIO DO FORK" />
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Procurar" Click="OnBrowse" />
                    <ui:TextBox x:Name="RepoBox" PlaceholderText="C:\repos\reversa" />
                </DockPanel>

                <TextBlock Style="{StaticResource SectionLabel}" Text="PREFIXO DAS SUAS SKILLS" />
                <ui:TextBox x:Name="PrefixBox" PlaceholderText="fg-" />
                <TextBlock Style="{StaticResource Hint}" Text="Evita conflito com o upstream e com o bug de prefixo do reversa update. Termine com hífen." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="AUTOR PADRÃO (metadata.author)" />
                <ui:TextBox x:Name="AuthorBox" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="TEMA" />
                <ComboBox x:Name="ThemeBox">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Light" />
                </ComboBox>

                <Separator Margin="0,20,0,4" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="Assistente (API do Claude)" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="MODELO" />
                <ComboBox x:Name="ModelBox" IsEditable="True">
                    <ComboBoxItem Content="claude-opus-5-5" />
                    <ComboBoxItem Content="claude-sonnet-5-5" />
                    <ComboBoxItem Content="claude-haiku-5-5" />
                    <ComboBoxItem Content="claude-fable-5-2" />
                </ComboBox>
                <TextBlock Style="{StaticResource Hint}" Text="Padrão: claude-opus-5-5. Fable 5.2 é o mais capaz e o mais caro; Sonnet e Haiku são mais baratos." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="ESFORÇO (effort)" />
                <ComboBox x:Name="EffortBox">
                    <ComboBoxItem Content="low" />
                    <ComboBoxItem Content="medium" />
                    <ComboBoxItem Content="high" />
                    <ComboBoxItem Content="xhigh" />
                    <ComboBoxItem Content="max" />
                </ComboBox>
                <TextBlock Style="{StaticResource Hint}" Text="medium dá conta da entrevista; high escreve corpos mais elaborados, com mais tokens." />

                <CheckBox x:Name="WebSearchBox" Margin="0,14,0,0" Content="Permitir busca na web por referências externas (até 5 buscas por pedido)" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="CHAVE DA API (opcional)" />
                <ui:PasswordBox x:Name="KeyBox" PlaceholderText="Deixe em branco para manter a atual" />
                <CheckBox x:Name="ClearKeyBox" Margin="0,8,0,0" Content="Remover a chave salva no app" />
                <TextBlock Style="{StaticResource Hint}" x:Name="CredentialHint" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="A chave fica cifrada com DPAPI no seu usuário do Windows. Sem chave no app, o SDK usa ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN ou o perfil do `ant auth login`." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" IsCancel="True" Click="OnCancel" />
                <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Salvar" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
