<Application x:Class="SkillStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SkillStudio.App.Converters"
             xmlns:vm="clr-namespace:SkillStudio.App.ViewModels"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:SeverityToSymbolConverter x:Key="SeverityToSymbol" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrush" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </Style>
            <!-- Seletor Editar / Dividir / Visualizar dos editores de Markdown. -->
            <Style x:Key="ViewModeButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <DataTemplate DataType="{x:Type vm:MarkdownViewMode}">
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanPreview}">
                    <RadioButton Style="{StaticResource ViewModeButton}" IsChecked="{Binding IsEdit}" ToolTip="Só o texto">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Edit16" Margin="0,0,4,0" /><TextBlock Text="Editar" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ViewModeButton}" IsChecked="{Binding IsSplit}" ToolTip="Texto e Markdown formatado lado a lado">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="SplitVertical20" Margin="0,0,4,0" /><TextBlock Text="Dividir" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ViewModeButton}" IsChecked="{Binding IsPreview}" ToolTip="Só o Markdown formatado">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Eye16" Margin="0,0,4,0" /><TextBlock Text="Visualizar" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DataTemplate>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
